# Port des Backends (im Dev-Modus leitet Vite /api dorthin weiter)
PORT=3000
# Adresse, auf der der Server lauscht (0.0.0.0 = im ganzen Netz erreichbar)
HOST=0.0.0.0
# Ordner für die SQLite-Datenbank und die Sicherungen
DATA_DIR=./data
# Ordner mit den Inhalten (Markdown/JSON)
CONTENT_DIR=./content
# Optional: Endpunkt POST /api/inhalte/neu-laden in Produktion erlauben
ALLOW_CONTENT_RELOAD=false
# Optional: Inhalte auch im Produktionsbetrieb bei Änderungen neu laden (im Docker-Betrieb voreingestellt)
CONTENT_WATCH=false
# Optional: Ordner abfragen statt auf Dateisystem-Ereignisse zu warten (bei Docker unter Windows/macOS sinnvoll)
CONTENT_WATCH_POLL=false
